EURI_API_KEY=your_api_key_here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256

# ─── MLflow (optional — experiment tracking UI) ─────────────────────────────
# MLflow is optional. The pipeline works without it (falls back to JSONL).
# To enable: pip install mlflow && mlflow ui --port 5000
# Then visit http://localhost:5000 to see the experiment tracking UI.
MLFLOW_TRACKING_URI=http://localhost:5000
